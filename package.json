{
  "name": "sandbox-win-mcp",
  "version": "2.0.0-alpha.1",
  "description": "Hardened Windows Sandbox automation: MCP server + sbx CLI. Fork of shanselman/sandbox-mcp v1.2.0 (MIT) with reliability, UIA-first input and security hardening.",
  "main": "src/core.js",
  "type": "module",
  "bin": {
    "sbx": "src/cli.js",
    "sandbox-win-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:handshake": "node test/mcp-handshake.js",
    "smoke": "node test/smoke.js",
    "e2e": "node test/smoke.js && node test/offline.js",
    "package:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "test:package": "node test/package-smoke.js"
  },
  "files": [
    "src",
    "agent",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "windows-sandbox",
    "windows",
    "sandbox",
    "testing",
    "automation",
    "ai-agent",
    "wsb",
    "security",
    "hardened"
  ],
  "author": "sandbox-win-mcp contributors",
  "contributors": [
    "Upstream: shanselman (sandbox-mcp) <https://github.com/shanselman/sandbox-mcp>"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
